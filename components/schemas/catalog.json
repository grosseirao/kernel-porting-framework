{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "metadata_license", "origins", "components"],
  "properties": {
    "schema": {"const": 1, "type": "integer"},
    "metadata_license": {"const": "MIT"},
    "origins": {"type": "object", "minProperties": 1, "additionalProperties": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "version", "revision", "license"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^([0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
        "license": {"type": "string", "minLength": 1}
      }
    }},
    "components": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
