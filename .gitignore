!/historical/**
!/boards/
!/boards/**
!/components/
!/components/**
!/third-party/
!/third-party/*.md
!/third-party/patches/
!/third-party/patches/*.patch
!/tools/
/tools/*
!/tools/*.py
!/tools/*.sh
!/tools/*.ps1
!/tools/*.c
!/tools/*.h
!/tools/tests/
