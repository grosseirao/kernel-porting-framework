# Device ports own their Git history; never stage nested repositories here.
!/ports/
/ports/*
!/ports/README.md

# Device sources have an independent Git in ports/. Legacy on-disk originals
# remain preserved locally during recovery handover; do not re-stage them here.
/boards/
/historical/
/installer/
/patches/
/third-party/
/initramfs*/
